<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string></string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.moonloaf.geospoof</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>geospoof</string>
			</array>
		</dict>
	</array>
	<!--
		GPX route files, so a track can be opened straight into GeoSpoof from AirDrop, Mail,
		Files or another app's share sheet. GPX files are born on a computer — you export them
		from Strava, Garmin or Komoot at a desk — so AirDrop is the realistic way one reaches a
		phone, and a file picker alone would make that feel like homework.

		Declared as an IMPORTED type, not exported: GPX is a public format defined by
		topografix.com and we neither own it nor write it. `com.topografix.gpx` is the
		identifier the ecosystem has settled on, and conforming to `public.xml` means a file
		served with a generic XML type still routes here.

		LSHandlerRank is `Alternate` on purpose. `Owner` would claim we define the format and
		`Default` would claim we should be the system's default GPX app — neither is true, and
		either would push us ahead of a user's actual mapping app in the Open In list.
	-->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.topografix.gpx</string>
			<key>UTTypeDescription</key>
			<string>GPS Exchange Format</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>gpx</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/gpx+xml</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>GPS Exchange Format</string>
			<!-- Viewer, not Editor: we read a route out of the file and never write one back. -->
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.topografix.gpx</string>
			</array>
		</dict>
	</array>
	<key>SFSafariWebExtensionConverterVersion</key>
	<string>26.4.1</string>
	<key>UIAppFonts</key>
	<array>
		<string>Nunito-Variable.ttf</string>
		<string>Outfit.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
