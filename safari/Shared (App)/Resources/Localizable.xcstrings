    "GeoSpoof is an indie, open source project. Tips are completely optional and go straight to development. Thank you!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "GeoSpoof ist ein unabhängiges Open-Source-Projekt. Trinkgeld ist völlig freiwillig und fließt direkt in die Entwicklung. Vielen Dank!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "GeoSpoof es un proyecto independiente y de código abierto. Las propinas son totalmente opcionales y van directas al desarrollo. ¡Gracias!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "GeoSpoof est un projet indépendant et open source. Les pourboires sont entièrement facultatifs et servent directement au développement. Merci !"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "GeoSpoof adalah proyek independen dengan sumber terbuka. Tip sepenuhnya opsional dan langsung digunakan untuk pengembangan. Terima kasih!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "GeoSpoofは個人開発のオープンソースプロジェクトです。チップは完全に任意で、そのまま開発に使われます。ありがとうございます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "GeoSpoof is een onafhankelijk opensourceproject. Een tip is volledig vrijwillig en gaat rechtstreeks naar de ontwikkeling. Bedankt!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O GeoSpoof é um projeto independente e de código aberto. As gorjetas são totalmente opcionais e vão direto para o desenvolvimento. Obrigado!"
          }
        },
        "ru" : {
          "stringUnit" : {
