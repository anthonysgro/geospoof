    "Only * is a wildcard — no regular expressions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nur * ist ein Platzhalter – reguläre Ausdrücke werden nicht unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solo * es un comodín; no se admiten expresiones regulares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seul * est un caractère générique ; les expressions régulières ne sont pas prises en charge."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hanya * yang merupakan wildcard — ekspresi reguler tidak didukung."
