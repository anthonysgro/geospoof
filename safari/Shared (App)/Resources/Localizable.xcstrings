    "Matches your spoofed location to your current public IP. Auto Background Sync keeps it matched as your VPN changes — even in the background." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Passt deinen vorgetäuschten Standort an deine aktuelle öffentliche IP an. Die automatische Hintergrundsynchronisierung hält ihn bei VPN-Wechseln angepasst — auch im Hintergrund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajusta tu ubicación falsificada a tu IP pública actual. La sincronización automática en segundo plano la mantiene ajustada cuando cambia tu VPN, incluso en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aligne votre position simulée sur votre IP publique actuelle. La synchronisation auto en arrière-plan la maintient alignée lorsque votre VPN change, même en arrière-plan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menyesuaikan lokasi palsu Anda dengan IP publik Anda saat ini. Sinkronisasi otomatis di latar belakang menjaganya tetap sesuai saat VPN Anda berubah — bahkan di latar belakang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "偽装された位置を現在のパブリックIPに合わせます。バックグラウンド自動同期により、VPNが変わっても一致した状態が保たれます（バックグラウンドでも動作）。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stemt je vervalste locatie af op je huidige openbare IP. Automatisch synchroniseren op de achtergrond houdt dit bij als je VPN wijzigt — ook op de achtergrond."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajusta sua localização falsificada ao seu IP público atual. A sincronização automática em segundo plano mantém o ajuste quando sua VPN muda — mesmo em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Приводит подменённое местоположение в соответствие с вашим текущим публичным IP. Автосинхронизация в фоне поддерживает соответствие при смене VPN — даже в фоновом режиме."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anpassar din förfalskade plats till din nuvarande offentliga IP. Automatisk synk i bakgrunden håller den anpassad när ditt VPN ändras – även i bakgrunden."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Khớp vị trí giả mạo của bạn với IP công khai hiện tại. Tự động đồng bộ ở chế độ nền giữ cho vị trí luôn khớp khi VPN thay đổi — kể cả khi chạy nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "让伪造的位置与你当前的公网 IP 保持一致。开启后台自动同步后，VPN 变化时也会持续保持一致，即使在后台也是如此。"
          }
        }
      }
    },
