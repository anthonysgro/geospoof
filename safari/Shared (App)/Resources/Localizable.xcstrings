    "Thank you so much for supporting GeoSpoof!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vielen Dank für deine Unterstützung von GeoSpoof!"
          }
        },
        "es" : {
