    },
    "Allowlist is empty, so spoofing is currently inactive on every site. Add a site to start spoofing there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Zulassungsliste ist leer, daher ist die Fälschung derzeit auf allen Websites inaktiv. Füge eine Website hinzu, um dort mit der Fälschung zu beginnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La lista de permitidos está vacía, así que la falsificación está inactiva en todos los sitios. Añade un sitio para empezar a falsificar ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La liste d’autorisation est vide : la simulation est donc inactive sur tous les sites. Ajoutez un site pour commencer à y simuler votre position."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Daftar izin masih kosong, jadi pemalsuan saat ini tidak aktif di situs mana pun. Tambahkan sebuah situs untuk mulai memalsukan lokasi di situs itu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "許可リストが空のため、現在どのサイトでも偽装は無効です。サイトを追加すると、そのサイトで偽装が始まります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De lijst met toegestane sites is leeg, dus spoofing is momenteel op elke site inactief. Voeg een site toe om daar te beginnen met spoofen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A lista de permissões está vazia, então a falsificação está inativa em todos os sites. Adicione um site para começar a falsificar nele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Белый список пуст, поэтому подмена сейчас не работает ни на одном сайте. Добавьте сайт, чтобы включить подмену на нём."
          }
        },
        "sv" : {
          "stringUnit" : {
