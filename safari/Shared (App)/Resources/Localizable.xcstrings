    "Sites will show their own location permission prompt. Your spoofed location is used only after you allow it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Websites zeigen ihre eigene Standortabfrage. Dein vorgetäuschter Standort wird erst verwendet, nachdem du zugestimmt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los sitios mostrarán su propia solicitud de permiso de ubicación. Tu ubicación falsificada solo se usa después de que lo permitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les sites afficheront leur propre demande d’autorisation de localisation. Votre position simulée n’est utilisée qu’après votre accord."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Situs akan menampilkan permintaan izin lokasinya sendiri. Lokasi palsu Anda hanya dipakai setelah Anda mengizinkannya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "サイトは独自の位置情報の許可ダイアログを表示します。偽装された位置は、許可した後にのみ使われます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sites tonen hun eigen verzoek om locatietoestemming. Je vervalste locatie wordt pas gebruikt nadat je toestemming geeft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os sites mostrarão a própria solicitação de permissão de localização. Sua localização falsificada só é usada depois que você permitir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сайты покажут собственный запрос разрешения на доступ к местоположению. Подменённое местоположение используется только после вашего согласия."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Webbplatser visar sin egen förfrågan om platsbehörighet. Din förfalskade plats används först när du har godkänt den."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Các trang web sẽ hiện hộp thoại xin quyền vị trí của riêng chúng. Vị trí giả mạo của bạn chỉ được dùng sau khi bạn cho phép."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "网站会显示其自带的位置权限提示。只有在你允许之后，才会使用伪造的位置。"
          }
        }
      }
    },
