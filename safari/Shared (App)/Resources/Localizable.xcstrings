    " Choose Allowlist or Denylist to limit spoofing to specific sites." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " Wähle Zulassungsliste oder Sperrliste, um die Fälschung auf bestimmte Websites zu beschränken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " Elige Lista de permitidos o Lista de bloqueados para limitar la falsificación a sitios concretos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " Choisissez Liste d’autorisation ou Liste de blocage pour limiter la simulation à certains sites."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " Pilih Daftar izin atau Daftar blokir untuk membatasi pemalsuan pada situs tertentu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " 特定のサイトだけに偽装を限定するには、許可リストまたは拒否リストを選択してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " Kies Toestaan of Blokkeren om spoofing tot bepaalde sites te beperken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " Escolha Lista de permissões ou Lista de bloqueio para limitar a falsificação a sites específicos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " Выберите «Белый список» или «Чёрный список», чтобы ограничить подмену определёнными сайтами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " Välj Tillåtlista eller Blocklista för att begränsa förfalskningen till vissa webbplatser."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " Chọn Cho phép hoặc Chặn để giới hạn việc giả mạo ở những trang web nhất định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " 选择「允许列表」或「拒绝列表」，即可将伪造限定于特定网站。"
