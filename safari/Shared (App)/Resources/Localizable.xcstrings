    "RTCPeerConnection is wrapped to suppress ICE candidate gathering, preventing WebRTC from leaking your real IP address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "RTCPeerConnection wird umschlossen, um das Sammeln von ICE-Kandidaten zu unterdrücken. So kann WebRTC deine echte IP-Adresse nicht preisgeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "RTCPeerConnection se envuelve para impedir la recopilación de candidatos ICE, evitando que WebRTC filtre tu dirección IP real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "RTCPeerConnection est encapsulé afin d’empêcher la collecte des candidats ICE, ce qui évite que WebRTC divulgue votre adresse IP réelle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "RTCPeerConnection dibungkus untuk menekan pengumpulan kandidat ICE, sehingga WebRTC tidak membocorkan alamat IP asli Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "RTCPeerConnectionをラップしてICE候補の収集を抑制し、WebRTCが実際のIPアドレスを漏らさないようにします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "RTCPeerConnection wordt omhuld om het verzamelen van ICE-kandidaten te onderdrukken, zodat WebRTC je echte IP-adres niet kan prijsgeven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O RTCPeerConnection é encapsulado para impedir a coleta de candidatos ICE, evitando que o WebRTC exponha seu endereço IP real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "RTCPeerConnection оборачивается, чтобы подавить сбор ICE-кандидатов и не дать WebRTC раскрыть ваш настоящий IP-адрес."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "RTCPeerConnection kapslas in för att förhindra insamling av ICE-kandidater, så att WebRTC inte kan läcka din riktiga IP-adress."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "RTCPeerConnection được bao lại để ngăn việc thu thập ứng viên ICE, nhờ đó WebRTC không làm lộ địa chỉ IP thật của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "RTCPeerConnection 被封装以阻止收集 ICE 候选，从而防止 WebRTC 泄露你的真实 IP 地址。"
          }
        }
      }
    },
