    "Billed to your Apple Account. Auto-renews unless canceled at least 24 hours before the period ends — manage in Settings. Unused free-trial time is forfeited on purchase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abrechnung über deinen Apple Account. Verlängert sich automatisch, sofern nicht mindestens 24 Stunden vor Ende des Zeitraums gekündigt wird — Verwaltung in den Einstellungen. Nicht genutzte Zeit einer kostenlosen Testphase verfällt beim Kauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se cargará a tu Apple Account. Se renueva automáticamente a menos que se cancele al menos 24 horas antes de que finalice el periodo; puedes gestionarlo en Ajustes. El tiempo restante de la prueba gratuita se pierde al comprar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Facturé sur votre Apple Account. Renouvellement automatique sauf annulation au moins 24 heures avant la fin de la période ; gestion dans Réglages. Le temps d’essai gratuit non utilisé est perdu à l’achat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ditagihkan ke Apple Account Anda. Diperpanjang otomatis kecuali dibatalkan setidaknya 24 jam sebelum periode berakhir — kelola di Pengaturan. Sisa masa uji coba gratis hangus saat pembelian."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apple Accountに請求されます。期間終了の24時間前までにキャンセルしない場合は自動更新されます（設定で管理できます）。無料トライアルの未使用分は購入時に無効になります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wordt via je Apple Account afgerekend. Wordt automatisch verlengd tenzij je minstens 24 uur voor het einde van de periode opzegt — beheren doe je in Instellingen. Niet-gebruikte proefperiode vervalt bij aankoop."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cobrado na sua Apple Account. Renova-se automaticamente, a menos que seja cancelado ao menos 24 horas antes do fim do período — gerencie em Ajustes. O tempo restante do teste grátis é perdido na compra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Списание с вашего Apple Account. Подписка продлевается автоматически, если не отменить её не позднее чем за 24 часа до окончания периода, — управление в Настройках. Неиспользованный бесплатный период при покупке не сохраняется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Debiteras ditt Apple Account. Förnyas automatiskt om den inte avbryts minst 24 timmar innan perioden tar slut – hantera detta i Inställningar. Oanvänd tid av provperioden går förlorad vid köp."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Được tính vào Apple Account của bạn. Tự động gia hạn trừ khi bạn huỷ ít nhất 24 giờ trước khi kỳ hạn kết thúc — quản lý trong Cài đặt. Thời gian dùng thử miễn phí chưa dùng sẽ mất khi bạn mua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "从你的 Apple Account 扣款。若未在当前周期结束前至少 24 小时取消，将自动续期，可在「设置」中管理。购买后，免费试用的剩余时长将失效。"
          }
        }
      }
    },
    "Blocked Sites" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
