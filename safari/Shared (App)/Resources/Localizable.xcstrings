    "Lifetime is a one-time purchase tied to your Apple Account — it restores automatically when you reinstall or set up a new device. There's no subscription to manage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Lebenslang“ ist ein Einmalkauf, der mit deinem Apple Account verknüpft ist — er wird bei einer Neuinstallation oder auf einem neuen Gerät automatisch wiederhergestellt. Es gibt kein Abo zu verwalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«De por vida» es una compra única vinculada a tu Apple Account: se restaura automáticamente al reinstalar o configurar un dispositivo nuevo. No hay ninguna suscripción que gestionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "« À vie » est un achat unique lié à votre Apple Account : il est restauré automatiquement lors d’une réinstallation ou sur un nouvel appareil. Il n’y a aucun abonnement à gérer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Seumur hidup” adalah pembelian sekali bayar yang terhubung ke Apple Account Anda — akan dipulihkan otomatis saat Anda memasang ulang atau menyiapkan perangkat baru. Tidak ada langganan yang perlu dikelola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「買い切り」はApple Accountに紐付いた一度だけの購入です。再インストール時や新しいデバイスの設定時に自動で復元されます。管理が必要なサブスクリプションはありません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'Levenslang' is een eenmalige aankoop die aan je Apple Account is gekoppeld — hij wordt automatisch hersteld als je opnieuw installeert of een nieuw apparaat configureert. Er is geen abonnement om te beheren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Vitalício” é uma compra única vinculada à sua Apple Account — ela é restaurada automaticamente quando você reinstala ou configura um novo dispositivo. Não há assinatura para gerenciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Навсегда» — разовая покупка, привязанная к вашему Apple Account: она восстанавливается автоматически при переустановке или настройке нового устройства. Подпиской управлять не нужно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "”Livstid” är ett engångsköp kopplat till ditt Apple Account – det återställs automatiskt när du installerar om eller konfigurerar en ny enhet. Det finns ingen prenumeration att hantera."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Vĩnh viễn” là một lần mua gắn với Apple Account của bạn — nó tự động phục hồi khi bạn cài lại hoặc thiết lập thiết bị mới. Không có gói đăng ký nào cần quản lý."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「永久」是与你的 Apple Account 绑定的一次性购买，重新安装或设置新设备时会自动恢复。无需管理任何订阅。"
          }
        }
      }
    },
