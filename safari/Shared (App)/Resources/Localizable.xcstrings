        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Daftar izin dan Daftar blokir adalah fitur GeoSpoof Pro. Tingkatkan untuk membatasi pemalsuan pada situs tertentu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "許可リストと拒否リストはGeoSpoof Proの機能です。アップグレードすると、特定のサイトだけに偽装を限定できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toestaan en Blokkeren zijn een functie van GeoSpoof Pro. Upgrade om spoofing tot bepaalde sites te beperken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lista de permissões e Lista de bloqueio são um recurso do GeoSpoof Pro. Faça upgrade para limitar a falsificação a sites específicos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Белый список» и «Чёрный список» — функция GeoSpoof Pro. Оформите Pro, чтобы ограничить подмену определёнными сайтами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
