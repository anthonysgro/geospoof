    "Mask the location and timezone you reveal online with a tap -- and keep your real whereabouts private." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verbirg Standort und Zeitzone, die du online preisgibst, mit einem Tippen — und halte deinen echten Aufenthaltsort privat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oculta con un toque la ubicación y la zona horaria que revelas en internet, y mantén en privado dónde estás realmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Masquez d’un geste la position et le fuseau horaire que vous révélez en ligne, et gardez privé l’endroit où vous êtes vraiment."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sembunyikan lokasi dan zona waktu yang Anda tampilkan online dengan sekali ketuk — dan jaga keberadaan Anda yang sebenarnya tetap privat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "オンラインで明かす位置情報とタイムゾーンをワンタップで隠し、実際の居場所を人に知られないようにします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verberg met één tik de locatie en tijdzone die je online prijsgeeft — en houd privé waar je echt bent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oculte com um toque a localização e o fuso horário que você revela online — e mantenha em sigilo onde realmente está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Одним касанием скройте местоположение и часовой пояс, которые вы раскрываете в сети, — и сохраните в тайне, где вы действительно находитесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dölj platsen och tidszonen du avslöjar online med en tryckning – och håll privat var du verkligen är."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chỉ một lần chạm để che vị trí và múi giờ mà bạn để lộ trên mạng — và giữ kín nơi bạn thực sự đang ở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "轻点一下，即可隐藏你在网上暴露的位置和时区，让真实所在地不被他人知晓。"
          }
        }
      }
    },
