    "Not for AR games like Pokémon GO — device GPS is for privacy, browsing, and development." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nicht für AR-Spiele wie Pokémon GO — das Geräte-GPS dient Privatsphäre, Surfen und Entwicklung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No sirve para juegos de RA como Pokémon GO: el GPS del dispositivo es para privacidad, navegación y desarrollo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
