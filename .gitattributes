# Treat media and other binary assets as binary so Git never applies
# text/EOL normalization or UTF-8 re-encoding (which corrupts the bytes,
# e.g. turning invalid sequences into the U+FFFD replacement char and
# destroying MP4 moov atoms).
*.mp4   binary
*.webm  binary
*.mov   binary
*.m4v   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary

# The shared route-id golden fixture, byte-identical with the copy in the geospoof-gps
# repository. Pinned to LF so a Windows checkout with core.autocrlf=true can't rewrite it and
# break a comparison for a reason unrelated to its contents. Mirrors the same pin on that side.
tests/fixtures/route-id-fixture.json text eol=lf
