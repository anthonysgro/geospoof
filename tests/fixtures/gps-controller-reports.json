    {
      "name": "still — spoofing one coordinate, neither nested object present",
      "why": "Absence is meaningful and is the normal state. A missing route or steering key must decode cleanly, not error. 'still' means actively holding one coordinate, NOT doing nothing.",
      "report": {
        "id": "mac-abc123",
        "name": "Anthony's MacBook Air",
        "version": 1,
        "agent_version": "0.2.0",
        "connected": true,
        "session": "spoofing",
        "provenance": "vpn-sync",
        "motion": "still",
        "remediation": "",
        "error": null,
        "pro": true,
