        "device": { "name": "iPhone", "product_type": "iPhone17,1", "ios_version": "26.5" },
        "steering": {
          "seq": 7,
          "heading_deg": 90.0,
          "speed_mps": 3.0,
          "latitude": 35.67049,
          "longitude": 139.70035,
          "travelled_m": 32.0,
          "ttl_secs": 600,
          "expires_in_secs": 540,
          "held": false,
          "expired": false,
          "rejected": null
