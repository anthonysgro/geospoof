{
  "_comment": "Decode contract for the GeoSpoof GPS agent's per-computer status file, Documents/controllers/<id>.json. Consumed by the native Swift decode test (geospoof-ios:app/GeoSpoofTests/GpsStatusDecodeTests.swift) against GpsStatus / GpsRouteStatus / GpsSteeringStatus in 'geospoof-ios:app/iOS (App)/SceneDelegate.swift'. Every 'report' below is copied from a JSON block in geospoof-gps/APP_CONTRACT.md or constructed to exercise a rule that document states in prose, so the app's model and the documented wire format cannot drift apart silently. The pairing is deliberate: the contract's own doc test asserts its examples stay complete, and this asserts we decode them. There is no TypeScript counterpart — the extension never reads these files.",

  "cases": [
    {
      "name": "route playing — the contract's canonical example, all nine route fields",
      "why": "An implementer builds their decoding struct from the canonical JSON block rather than the prose, so every field the agent emits must be present here. started_at and remaining_secs were once explained below the example but absent from it, which would have silently dropped both.",
      "report": {
        "id": "mac-abc123",
        "name": "Anthony's MacBook Air",
        "version": 1,
        "agent_version": "0.2.0",
        "connected": true,
        "session": "spoofing",
        "provenance": "from-app",
        "motion": "route",
        "remediation": "",
        "error": null,
        "pro": true,
        "transport": "wireless",
        "updated_at": 1789300123,
        "device": { "name": "iPhone", "product_type": "iPhone17,1", "ios_version": "26.5" },
        "route": {
          "id": "morning-run-2026-09-13",
          "started_at": 1789300000,
          "name": "Morning run",
          "travelled_m": 412.5,
          "total_m": 1113.0,
          "remaining_secs": 234,
          "paused": false,
          "finished": false,
          "speed_defaulted": false
        }
      },
      "expect": {
        "session": "spoofing",
        "isSpoofing": true,
        "deliveredMotion": "route",
        "transport": "wireless",
        "deliversRoute": true,
        "deliversSteering": false,
        "hasRoute": true,
        "hasSteering": false,
        "route": {
          "id": "morning-run-2026-09-13",
          "startedAt": 1789300000,
          "name": "Morning run",
          "travelledM": 412.5,
          "totalM": 1113.0,
          "remainingSecs": 234,
          "paused": false,
          "finished": false,
          "speedDefaulted": false
        }
      }
    },

    {
      "name": "steering — all eleven fields including the integrated position",
      "why": "The one place a status report tells us a coordinate. seq is what makes the timing fields trustworthy; expires_in_secs is what a countdown must be built from.",
