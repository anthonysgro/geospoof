        "updated_at": 1789300123,
        "device": { "name": "iPhone", "product_type": "iPhone17,1", "ios_version": "26.5" }
      },
      "expect": {
        "isSpoofing": true,
        "deliveredMotion": "still",
        "deliversRoute": false,
        "deliversSteering": false,
        "hasRoute": false,
        "hasSteering": false
      }
    },

    {
      "name": "older agent — no motion, no transport, spoofing",
      "why": "An agent that predates the motion field ignores what it doesn't know, holds the coordinate, and reports no mode. The app must read that as 'this computer is not delivering the mode I asked for' — degraded but visibly so — rather than failing the decode.",
      "report": {
        "id": "mac-old",
        "name": "Old iMac",
        "version": 1,
        "agent_version": "0.1.9",
        "connected": true,
        "session": "spoofing",
        "provenance": "from-app",
        "remediation": "",
        "error": null,
        "pro": true,
        "updated_at": 1789300123,
        "device": { "name": "iPhone", "product_type": "iPhone17,1", "ios_version": "26.5" }
      },
      "expect": {
        "isSpoofing": true,
        "deliveredMotion": null,
        "transport": "unknown",
        "deliversRoute": false,
        "deliversSteering": false,
        "hasRoute": false,
        "hasSteering": false
      }
    },

    {
      "name": "idle — not spoofing, so the mode question is meaningless",
      "why": "THE trap. An absent motion here means nothing is driving a location, not that the computer lacks a capability. Telling a user 'this computer can't steer' when spoofing is simply switched off would be wrong, and this exact mistake was already made once against an unreachable iPad. deliveredMotion must be null because session is not 'spoofing'.",
      "report": {
        "id": "mac-abc123",
        "name": "Anthony's MacBook Air",
        "version": 1,
        "agent_version": "0.2.0",
        "connected": true,
        "session": "idle",
        "provenance": "unknown",
        "remediation": "",
        "error": null,
        "pro": true,
        "transport": "usb",
        "updated_at": 1789300123,
        "device": { "name": "iPhone", "product_type": "iPhone17,1", "ios_version": "26.5" }
      },
      "expect": {
        "isSpoofing": false,
        "deliveredMotion": null,
        "deliversRoute": false,
        "deliversSteering": false
      }
    },

    {
      "name": "idle but motion present — session still wins",
      "why": "Guards the guard. Even if a future agent emitted a mode while idle, deliveredMotion is gated on session, so nothing downstream can render a mode for a device nobody is driving.",
      "report": {
        "id": "mac-abc123",
        "name": "Anthony's MacBook Air",
        "version": 1,
        "agent_version": "0.3.0",
        "connected": true,
        "session": "idle",
