        "updated_at": 1789300123
      },
      "expect": {
        "isSpoofing": false,
        "deliveredMotion": null,
        "deliversRoute": false,
        "deliversSteering": false
      }
    },

    {
      "name": "unrecognised motion from a newer agent",
      "why": "Unknown enum values degrade, never fail. A future mode this build has never heard of reads as the catch-all, and crucially does NOT read as any mode we might have asked for — so the echo rule still reports it honestly as not delivered.",
      "report": {
        "id": "mac-future",
        "name": "Future Mac",
        "version": 1,
        "agent_version": "9.9.9",
        "connected": true,
        "session": "spoofing",
        "provenance": "from-app",
        "motion": "orbital-drift",
        "remediation": "",
        "error": null,
        "pro": true,
        "transport": "starlink",
        "updated_at": 1789300123
      },
      "expect": {
        "isSpoofing": true,
        "deliveredMotion": "unknown",
        "transport": "unknown",
        "deliversRoute": false,
        "deliversSteering": false
      }
    },

