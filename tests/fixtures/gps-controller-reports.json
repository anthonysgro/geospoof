      },
      "expect": {
        "isSpoofing": true,
        "deliveredMotion": "steering",
        "transport": "usb",
        "deliversSteering": true,
        "deliversRoute": false,
        "hasRoute": false,
        "hasSteering": true,
        "steering": {
          "seq": 7,
          "headingDeg": 90.0,
          "speedMps": 3.0,
          "latitude": 35.67049,
